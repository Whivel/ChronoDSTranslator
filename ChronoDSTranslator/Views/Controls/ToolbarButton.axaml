<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ChronoDSTranslator.Views.Controls.ToolbarButton"
             x:Name="Self">
    <d:DesignData />
    <Border Padding="2 0 0 0" BorderThickness="2 0 0 0" Classes.Selected="{Binding #Self.IsSelected, Mode=OneWay}">
        <Button IsHitTestVisible="{Binding !#Self.IsSelected, Mode=OneWay}"
                Command="{Binding #Self.Command, Mode=OneWay}"
                CommandParameter="{Binding #Self.CommandParameter, Mode=OneWay}">
            <Image Width="24" Height="24" Source="{Binding #Self.Icon, Mode=OneWay}" />
        </Button>
    </Border>
</UserControl>