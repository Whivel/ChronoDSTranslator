<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChronoDSTranslator.ViewModels"
             xmlns:designViewModelsControls="clr-namespace:ChronoDSTranslator.Design.ViewModels.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ChronoDSTranslator.Views.Controls.TreeMenu"
             x:DataType="viewModels:Controls.TreeMenuViewModel">
    <Design.DataContext>
        <designViewModelsControls:DesignTreeMenuViewModel />
    </Design.DataContext>
    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto,*">
        <Border
            Grid.Row="0"
            Margin="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel Margin="1" Orientation="Horizontal">
                <Button
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Collapse All"
                    ToolTip.VerticalOffset="10">
                    <Image
                        Width="16"
                        Height="16"
                        RenderOptions.BitmapInterpolationMode="HighQuality">
                        <SvgImage Source="avares://ChronoDSTranslator/Assets/collpase_all.svg"
                                  Css="{DynamicResource CssFill}" />
                    </Image>
                </Button>
            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="1" Grid.Column="0"
            Margin="4,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Orientation="Vertical">
            <TextBox
                Name="SearchTextBox"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                AcceptsReturn="False"
                Classes.IsSmall="True"
                Classes.clearButton="True"
                TextWrapping="NoWrap"
                Watermark="Filter visible items">
                <TextBox.Styles>
                    <Style Selector="TextBox">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="InnerRightContent">
                            <Template>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Content="&#xE8BB;"
                                            RenderOptions.TextRenderingMode="SubpixelAntialias" />
                                        <Button
                                            Content="&#xE721;"
                                            IsHitTestVisible="False"
                                            RenderOptions.TextRenderingMode="SubpixelAntialias" />
                                    </StackPanel>
                                    <!-- <ui:ProgressRing
                                        Margin="0,0,2,0"
                                        IsIndeterminate="True"
                                        IsVisible="{Binding IsBusy}"
                                        RenderTransform="Scale(0.65, 0.65)" />-->
                                </StackPanel>

                            </Template>
                        </Setter>

                    </Style>
                </TextBox.Styles>
            </TextBox>
        </StackPanel>

        <ScrollViewer
            Grid.Row="2" Grid.Column="0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Visible">
            <TreeView ItemsSource="{Binding RootNode.Children.Items, Mode=OneWay}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children.Items, Mode=OneWay}">
                        <Grid ColumnDefinitions="24, *">
                            <Image Grid.Column="0"
                                   Source="{Binding Icon, Mode=OneWay}"
                                   Width="24" Height="{Binding #TxtLabel.LineHeight,Mode=OneWay}"
                                   Margin="0,0,8,0"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Name="TxtLabel"
                                       Text="{Binding Label, Mode=OneWay}"
                                       AutomationProperties.HelpText="{Binding AriaLabel, Mode=OneWay}"
                                       VerticalAlignment="Center" />
                        </Grid>

                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </ScrollViewer>
    </Grid>
</UserControl>