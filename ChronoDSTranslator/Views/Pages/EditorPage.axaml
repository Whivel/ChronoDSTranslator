<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:ChronoDSTranslator.Views.Controls"
             xmlns:viewModel="clr-namespace:ChronoDSTranslator.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ChronoDSTranslator.Views.Pages.EditorPage"
             x:DataType="viewModel:Pages.EditorPageViewModel">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="96" />
            <ColumnDefinition Width="Auto" MinWidth="4" />
            <ColumnDefinition Width="3*" MinWidth="192" />
        </Grid.ColumnDefinitions>

        <controls:TreeMenu Grid.Row="0" Grid.Column="0" Padding="4" />
        <GridSplitter Grid.Row="0" Grid.Column="1" Background="Black" ResizeDirection="Columns" />
        <TextBlock Grid.Row="0" Grid.Column="2">CIAO</TextBlock>
    </Grid>
</UserControl>