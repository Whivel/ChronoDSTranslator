<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:ChronoDSTranslator.ViewModel"
             xmlns:reactiveUi="http://reactiveui.net"
             xmlns:controls="clr-namespace:ChronoDSTranslator.Views.Controls"
             xmlns:pages="clr-namespace:ChronoDSTranslator.Views.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ChronoDSTranslator.Views.MainView"
             x:Name="Self">
    <Design.DataContext>
        <viewModel:MainViewModel />
    </Design.DataContext>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="96" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.Column="0" BorderThickness="0 00 2 0" BorderBrush="#CACACA">
            <controls:AppToolbar Padding="4" />
        </Border>
        <reactiveUi:RoutedViewHost Grid.Row="0" Grid.Column="1"
                                   Name="FrameView">
            <reactiveUi:RoutedViewHost.DefaultContent>
                <pages:WelcomePage />
            </reactiveUi:RoutedViewHost.DefaultContent>
        </reactiveUi:RoutedViewHost>
    </Grid>
</UserControl>